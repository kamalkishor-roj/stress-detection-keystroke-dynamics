{
  "name": "cognitive-load-detector",
  "version": "1.0.0",
  "description": "Cognitive Load Detection via Keystroke & Mouse Dynamics",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.cognitiveload.detector",
    "productName": "Cognitive Load Detector",
    "win": {
      "target": "nsis"
    },
    "files": [
      "src/**/*",
      "ml/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
